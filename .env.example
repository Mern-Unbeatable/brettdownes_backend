# ---- Core ----
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to send credentialed requests
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the storefront, used to build links inside emails
CLIENT_URL=http://localhost:5173
# Public URL of this API, used to build absolute upload URLs
API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=peptide_session
# Set to true when the API is served over HTTPS
COOKIE_SECURE=false
# Use "none" when the API and storefront live on different domains (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- First admin (created by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@peptideops.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Peptide Ops Admin

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
# Exposed to the storefront via GET /api/settings/public
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- EasyPost ----
# Test key (EZTK...) is used whenever NODE_ENV is not "production"
EASYPOST_TEST_API_KEY=EZTK_xxx
EASYPOST_API_KEY=EZAK_xxx
# Shared secret for tracker webhooks. Point EasyPost at:
#   POST {API_URL}/api/shipping/easypost/webhook?secret=YOUR_SECRET
EASYPOST_WEBHOOK_SECRET=
# Only for pointing at a sandbox/mock. Leave unset in production.
# EASYPOST_BASE_URL=

# ---- SMTP (Nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Peptide Ops Logistics <no-reply@peptideopslogistics.com>"

# ---- Uploads ----
MAX_UPLOAD_MB=5
